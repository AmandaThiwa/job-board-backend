{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth Service API",
    "description": "API documentation for the Job Board Authentication Service.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Auth Service Local Server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints for user signup, login, and logout"
    },
    {
      "name": "User Management",
      "description": "Endpoints for managing user profiles (CRUD)"
    }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "test@company.com" },
                  "password": { "type": "string", "example": "password123" },
                  "role": { "type": "string", "enum": ["seeker", "company", "admin"], "example": "seeker" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "User already exists or invalid data" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user and receive a JWT cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "test@company.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, JWT set in cookies" },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout user and clear JWT cookie",
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/api/auth/users": {
      "get": {
        "tags": ["User Management"],
        "summary": "Get all users (Admin only)",
        "responses": {
          "200": { "description": "A list of all users" }
        }
      }
    },
    "/api/auth/users/{id}": {
      "get": {
        "tags": ["User Management"],
        "summary": "Get user by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "User profile data" },
          "404": { "description": "User not found" }
        }
      },
      "put": {
        "tags": ["User Management"],
        "summary": "Update user profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "newemail@example.com" },
                  "password": { "type": "string", "example": "newpassword123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User profile updated" },
          "403": { "description": "Not authorized to update this user" },
          "404": { "description": "User not found" }
        }
      },
      "delete": {
        "tags": ["User Management"],
        "summary": "Delete a user account",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "User removed successfully" },
          "403": { "description": "Not authorized to delete this account" },
          "404": { "description": "User not found" }
        }
      }
    }
  }
}